# ░░ env sample variables ░░░░░░░░░░░░░░░░
# ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
#
# Astro frontend runtime vars
# Copy to .env and fill in values before running locally or building.
# In the container, these are set via compose environment: block (except
# ASTRO_BUILD_TRIGGER_SECRET, which is loaded from this file by deploy-orchestrator).

# CMS base URLs (no trailing slash)
DEV_CMS=https://your-wp-dev-domain.example
STAGING_CMS=https://your-wp-staging-domain.example

# WP REST API path segments (relative to CMS base URL)
REST_ENDPOINT=wp-json/wp/v2/
MENU_ENDPOINT=wp-json/abcnorio/v1/menus
BLOCKS_ENDPOINT=wp-json/vip-block-data-api/v1/

# Frontend canonical URLs per environment
DEV_FRONTEND_URL=https://dev.your-domain.example/
STAGING_FRONTEND_URL=https://staging.your-domain.example/
PRODUCTION_FRONTEND_URL=https://your-production-domain.example/
PREVIEW_FRONTEND_URL=https://preview.your-domain.example/

# Search API paths (relative to CMS base URL)
DEV_SEARCH_API=wp-json/abcnorio/v1/search
STAGING_SEARCH_API=wp-json/abcnorio/v1/search

# Shared bearer token for orchestrator /trigger endpoint
# Must match ASTRO_BUILD_TRIGGER_SECRET in abcnorio-meta/wp/runtime.env
ASTRO_BUILD_TRIGGER_SECRET=your-shared-secret-token
