---
const { event } = Astro.props;
import "./_add-to-calendar.scss";
const toDataValue = (value: unknown) => {
    if (value instanceof Date) {
        return value.toISOString();
    }

    if (value === undefined || value === null) {
        return '';
    }

    return String(value);
};
---
<add-to-calendar-button 
    class="add-to-calendar"
    data-title={toDataValue(event?.title)}
    data-description={toDataValue(event?.description)}
    data-start={toDataValue(event?.event_start_date)}
    data-end={toDataValue(event?.event_end_date)}
    data-location={toDataValue(event?.event_venue_name)}
    data-time-zone={toDataValue(event?.event_timezone)}
>   
    <button class="atc-actuator"
        aria-label="Add event to calendar"
        aria-controls="atc-drawer"
        aria-expanded="false"
        aria-hidden="true"
    >
        <svg width="24px" height="24px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 10H3M16 2V6M8 2V6M7.8 22H16.2C17.8802 22 18.7202 22 19.362 21.673C19.9265 21.3854 20.3854 20.9265 20.673 20.362C21 19.7202 21 18.8802 21 17.2V8.8C21 7.11984 21 6.27976 20.673 5.63803C20.3854 5.07354 19.9265 4.6146 19.362 4.32698C18.7202 4 17.8802 4 16.2 4H7.8C6.11984 4 5.27976 4 4.63803 4.32698C4.07354 4.6146 3.6146 5.07354 3.32698 5.63803C3 6.27976 3 7.11984 3 8.8V17.2C3 18.8802 3 19.7202 3.32698 20.362C3.6146 20.9265 4.07354 21.3854 4.63803 21.673C5.27976 22 6.11984 22 7.8 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="ui-label">Add to cal</span>
    </button>

    <div id="atc-drawer" class="atc-drawer">
        <button class="act-google">Google</button>
        <button class="act-apple">Apple</button>
        <button class="act-outlook">Outlook</button>
    </div>
</add-to-calendar-button>

<script>
    import { downloadICS, generateGoogleLink, generateOutlookLink } from './utils/generateLinks.js';

    class AddToCalendar extends HTMLElement {
        constructor() {
            super();
            const actuator = this.querySelector('.atc-actuator');
            const drawer = this.querySelector('.atc-drawer');
            const googleButton = this.querySelector('button.act-google');
            const appleButton = this.querySelector('button.act-apple');
            const outlookButton = this.querySelector('button.act-outlook');
            const event = Object.assign( {}, this.dataset );
            actuator.addEventListener('click', () => {
                const isActive = drawer.classList.contains('active');
                if (isActive) {
                    drawer.classList.remove('active');
                    actuator.setAttribute('aria-expanded', 'false');
                    actuator.setAttribute('aria-hidden', 'true');
                } else {
                    drawer.classList.add('active');
                    actuator.setAttribute('aria-expanded', 'true');
                    actuator.setAttribute('aria-hidden', 'false');
                }
            });
            googleButton.addEventListener('click', (e) => {
                e.preventDefault();
                const calLink = String(generateGoogleLink({ ...event }));
                window.open(calLink, '_blank');
            });
            appleButton.addEventListener('click', (e) => {
                e.preventDefault();
                downloadICS({ ...event });
            });
            outlookButton.addEventListener('click', (e) => {
                e.preventDefault();
                const calLink = String(generateOutlookLink({ ...event }));
                window.open(calLink, '_blank');
            });
        }
    }
    customElements.define('add-to-calendar-button', AddToCalendar);
</script>
