---
import "./_events_teaser.scss";
import { formatEventDate } from '@util/dates.js';

interface Props {
    data: any;
    showTeaser?: boolean;
}

const { data, showTeaser = true }: Props = Astro.props;
const startRaw = data?.acf?.event_start_date ?? '';
const start = formatEventDate(startRaw);
const endRaw = data?.acf?.event_end_date ?? '';
const end = formatEventDate(endRaw);
const slug  = data?.slug || '';
const title = data?.title?.rendered || slug || 'Untitled event';
const excerpt = data?.excerpt?.rendered || 'excerpt';
const featuredImage = data?.featured_image;
const teaserImage = featuredImage?.url ?? '';
const teaserImageAlt = featuredImage?.alt ?? '';
const teaserImageWidth = featuredImage?.width ?? 640;
const teaserImageHeight = featuredImage?.height ?? 360;
let isPastEvent = start ? new Date(start.datetime) < new Date() : false;
if( end?.datetime ) {
    isPastEvent = new Date(end.datetime) < new Date();
}


---
<article class={`teaser events ${isPastEvent ? 'past' : ''}`}>
    <a href={`/events/${slug}`}>
        {showTeaser && teaserImage && (
            <img src={teaserImage} alt={teaserImageAlt} width={teaserImageWidth} height={teaserImageHeight} loading="lazy" decoding="async" />
        )}

        <div class="content">
            {start && 
                <time datetime={start.label_time} set:html={`&nbsp;${start.label_date}<br/>&nbsp;@ ${start.label_time}&nbsp;`}></time>
                <h3 set:html={title}></h3>
            // <!-- <div set:html={ excerpt }></div> -->
            }
        </div>
    </a>
</article>
