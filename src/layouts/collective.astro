---
import Head from '@components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Debug } from 'astro:components';
const {
  title,
  description,
  keywords,
  canonical,
  ogImage,
  twitterSite,
  twitterCard,
} = Astro.props;
const slug = Astro.url.pathname.split('/').filter(Boolean).pop() || 'home';
---
<html lang="en">
  <Head
    title={title}
    description={description}
    keywords={keywords}
    canonical={canonical}
    ogImage={ogImage}
    twitterSite={twitterSite}
    twitterCard={twitterCard}
    loadHtmx={true}
  />
  <body class={`collective ${slug}`}>
    <Header />
    <main class="main">
        <slot name="header"/>
        <slot name="main"/>
        <slot name="sidebar" />
    </main>
    <Footer />
  </body>
  <script data-goatcounter="https://abcnorio.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</html>