---
import HTMLWrapper from "@layouts/html.astro";
import "./_sidebar.scss";

const {
  title,
  description,
  keywords,
  canonical,
  ogImage,
  twitterSite,
  twitterCard,
} = Astro.props;
---

<HTMLWrapper
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  ogImage={ogImage}
  twitterSite={twitterSite}
  twitterCard={twitterCard}
>
  <main class="sidebar-layout">
    <slot name="header" />
    <slot name="sidebar" />
    <slot name="main" />
  </main>
</HTMLWrapper>
