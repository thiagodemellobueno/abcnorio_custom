---
export const prerender = ['development', 'staging'].includes(String(process.env.MODE || '').toLowerCase()) ? false : ['full', 'collectives'].includes(process.env.SCOPE || 'full');

import Layout from '@layouts/page.astro';
import Block from '@components/wp-blocks/generic-block.astro';
import { SITE_URL, REST_PATH } from '@util/paths.js';
import { buildPostSeo } from '@util/seo.js';
import { fetchWpPost } from '@util/fetch-data.js';
import { collectiveSubpagePaths } from '@util/static-paths.js';

// DATA FLOW
// Static build (prerender=true, production/preview SCOPE):
//   getStaticPaths runs at build time — reads the collective_subpages collection
//   (cached WP data from wpCollectiveSubpagesLoader) and the parent-collectives
//   taxonomy terms (live REST fetch). Maps each subpage to its collective slug
//   via term ID to produce { slug, pageSlug } param pairs.
//   `post` prop is the cached collection entry data — fetchWpPost returns it as-is.
//
// SSR (prerender=false, development/staging MODE):
//   getStaticPaths does not run. Astro.props.post is undefined.
//   fetchWpPost falls back to fetching live from WP REST by pageSlug.
//   `slug` (collective segment) is available in Astro.params for path construction
//   but is not used to fetch — pageSlug alone identifies the page.

const { slug, pageSlug } = Astro.params;
const post: any = await fetchWpPost(
  `${REST_PATH}pages?slug=${encodeURIComponent(pageSlug ?? '')}`,
  (Astro.props as any)?.post,
);

const blocks: any[] = post?.blocks ?? [];
const seo = buildPostSeo({
  post,
  siteUrl: SITE_URL,
  pathname: `/collectives/${slug}/${pageSlug}/`,
});

export async function getStaticPaths() {
  return collectiveSubpagePaths(process.env.SCOPE);
}

---

<Layout {...seo}>
  <h1 set:html={post.title.rendered}></h1>
  {blocks.map((block: any) => <Block component={block.name} attributes={block.attributes} innerBlocks={block.innerBlocks} />)}
</Layout>
<style>
    h2, h3, h4 {
        border: 1px #000 solid
        margin-top: 2em;
    }
</style>