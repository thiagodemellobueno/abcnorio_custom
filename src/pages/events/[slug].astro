---
export const prerender = ['development', 'staging'].includes(String(process.env.MODE || '').toLowerCase()) ? false : ['full', 'events'].includes(process.env.SCOPE || 'full');
import { Debug } from "astro:components";
import Layout from "../../layouts/sidebar.astro";
import Block from "../../components/wp-blocks/generic-block.astro";
import ImageBlock from "../../components/wp-blocks/image.astro";
import ATC from "../../components/AddToCalendar/AddToCalendar.astro";

import "./_event.scss";

import { SITE_URL, REST_PATH } from "@util/paths.js";
import { buildPostSeo } from "@util/seo.js";
import { formatEventDate } from "@util/dates.js";
import { getCollection } from "astro:content";
import { collectionPaths } from "@util/static-paths.js";
import { fetchWpPost } from "@util/fetch-data.js";

const { slug } = Astro.params;
const post: any = await fetchWpPost(
  `${REST_PATH}events?slug=${encodeURIComponent(slug ?? '')}&_embed=wp:featuredmedia`,
  (Astro.props as any)?.post,
);

const blocks: any[] = post.blocks;
const seo = buildPostSeo({
  post,
  siteUrl: SITE_URL,
  pathname: `/events/${slug}/`,
});

const startDate: string = post.acf.event_start_date;
const endDate: string   = post.acf.event_end_date;
const venueName: string    = post.acf.event_venue_name;
const venueAddress: string = post.acf.event_venue_address;
const ticketsURL: string   = post.acf.event_tickets_url;
const timezone: string     = post.acf.event_timezone;
const eventDetails: Array<{ detail_label?: string; detail_text?: string }> = post.acf.event_details ?? [];
const featuredImage = post._embedded?.["wp:featuredmedia"]?.[0];
const eventTypeIds: number[] = post["event-types"];
const eventTypeTerms = await getCollection('event_types');
const eventTypeNames = eventTypeTerms
  .filter((entry: any) => eventTypeIds.includes(entry.data?.id))
  .map((entry: any) => ({ slug: entry.data?.slug, name: entry.data?.name }))
  .filter(Boolean);

const startFormatted = formatEventDate(startDate);
const endFormatted   = formatEventDate(endDate);

let display_date: string | undefined;
let display_time: string | undefined;
if (startFormatted && !endFormatted) {
  display_date = startFormatted.label_date;
  display_time = `@ ${startFormatted.label_time} ${startFormatted.ampm}`;
} else if (startFormatted && endFormatted) {
  display_date = `${startFormatted.label_date} - ${endFormatted.label_date}`;
  display_time = `@ ${startFormatted.label_time} ${startFormatted.ampm} - ${endFormatted.label_time} ${endFormatted.ampm}`;
}

export async function getStaticPaths() {
  return collectionPaths('events', process.env.SCOPE, 'events');
}
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  ogImage={seo.ogImage}
>
  <header slot="header">
    {
      display_date && display_time && (
        <time>
          <div set:html={`&nbsp;${display_date}&nbsp;`}></div>
          <div set:html={`&nbsp;${display_time}&nbsp;`}></div>
        </time>
      )
    }

    <h1 set:html={post.title.rendered} />

    {
      (venueName || venueAddress) && (
        <div class="venue-details">
          <strong>Venue details:</strong> {venueName && <h4>{venueName}</h4>}
          {venueAddress && <div>{venueAddress}</div>}
        </div>
      )
    }

    {
      featuredImage?.url && (
      <div class="event__poster">
        <ImageBlock
          loading="eager"
          decoding="async"
          attributes={{
            url: featuredImage.media_details.sizes.medium_large.source_url,
            alt: featuredImage.alt_text,
            caption: featuredImage.caption?.rendered,
            media_details: featuredImage.media_details,
          }}
        />
        </div>
      )
    }
  </header>

  <article slot="main">
    {
      blocks.map((block: any) => (
        <Block
          component={block.name}
          attributes={block.attributes}
          innerBlocks={block.innerBlocks || null}
        />
      ))
    }
  </article>

  <aside slot="sidebar">
    {
      startDate && (
        <ATC
          event={{
            title: post.title.rendered,
            description: post.excerpt.rendered,
            event_start_date: startDate,
            event_end_date: endDate,
            event_venue_name: venueName,
            event_timezone: timezone,
          }}
        />
      )
    }

    {
      eventTypeNames.length > 0 && (
        <div class="event-types-taxonomy">
            {eventTypeNames.map((term) => (
              <a href={`/events/event-type/${term.slug}/`}>{term.name}</a>
            ))}
        </div>
      )
    }

    {
      ticketsURL && (
        <button class="end-date" href={ticketsURL} target="_blank" rel="noopener noreferrer">  
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><title>Tickets SVG Icon</title><path fill="currentColor" d="M21 8h-2V3a1 1 0 0 0-1.37-.93l-15 6c-.09.04-.16.1-.24.16c-.03.02-.06.03-.09.06c-.04.04-.05.08-.08.12c-.05.06-.1.12-.13.19c-.01.02 0 .05-.02.08c-.03.1-.06.2-.06.31v3.55c0 .48.33.89.8.98a1.499 1.499 0 0 1 0 2.94c-.47.09-.8.5-.8.98v3.55c0 .55.45 1 1 1h18c.55 0 1-.45 1-1v-3.55c0-.48-.33-.89-.8-.98a1.499 1.499 0 0 1 0-2.94c.47-.09.8-.5.8-.98V8.99c0-.55-.45-1-1-1Zm-4 0H8.19L17 4.48zm3 3.84c-1.2.57-2 1.79-2 3.16s.8 2.59 2 3.16V20h-4v-2h-1v2H4v-1.84c1.2-.57 2-1.79 2-3.16s-.8-2.59-2-3.16V10h11v1h1v-1h4z"/><path fill="currentColor" d="M15 12h1v2h-1zm0 3h1v2h-1z"/></svg>
          <span class="ui-label">Get Tickets</span>
        </button>
      )
    }

    {
      eventDetails.length > 0 && (
        <dl class="event-details">
          {eventDetails.map(({ detail_label, detail_text }) =>
            detail_label || detail_text ? (
              <div class="event-details__row">
                {detail_label && <dt>{detail_label}</dt>}
                {detail_text && <dd>{detail_text}</dd>}
              </div>
            ) : null,
          )}
        </dl>
      )
    }
  </aside>
</Layout>
