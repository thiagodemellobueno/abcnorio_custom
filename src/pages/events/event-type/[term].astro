---
export const prerender = ['development', 'staging'].includes(String(process.env.MODE || '').toLowerCase()) ? false : ['full', 'events'].includes(process.env.SCOPE || 'full');

import Layout from "@layouts/events.astro";
import EventListing from "@components/Events/Events-Listing.astro";
import StaticPagination from "@components/Pagination/StaticPagination.astro";
import { getEvents } from "@lib/events/events.js";
import { getCollection } from "astro:content";
import { POSTS_PER_PAGE } from "@consts";

export async function getStaticPaths() {
  const types = await getCollection('event_types' as any);
  return Promise.all(
    types
      .filter((entry: any) => entry.id && entry.data?.id)
      .map(async (entry: any) => {
        const { events, total, totalPages } = await getEvents(
          { event_type: entry.data.id, orderby: 'event_start_date', order: 'desc' },
          { page: 1, perPage: POSTS_PER_PAGE },
        );
        return {
          params: { term: entry.id },
          props: { eventType: entry.data, events, total, totalPages },
        };
      }),
  );
}

const { term } = Astro.params;
const { eventType, events, total, totalPages } = Astro.props as any;
---

<Layout title={`Events: ${eventType?.name ?? term}`}>
  <h1>{eventType?.name ?? term}</h1>
  <EventListing events={events} total={total} />
  <StaticPagination
    currentPage={1}
    totalPages={totalPages}
    pageOneHref={`/events/event-type/${term}`}
    pageHref={(p: number) => `/events/event-type/${term}/${p}`}
  />
</Layout>
